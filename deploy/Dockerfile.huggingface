# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CC=gcc \
    CXX=g++ \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
    CMAKE_ARGS="-DGGML_CUDA=OFF -DGGML_NATIVE=OFF"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential cmake libgomp1 tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Immutable source revision. BuildKit verifies the archive digest before use.
ADD --checksum=sha256:8445d52088858f4f9e99ae6ab57ed9c21b4d32d7a401e3a5c6c31136995ef322 https://codeload.github.com/ayaan-27/Miraflores_Project/tar.gz/4ff4d5523c901550a511d6c5ae7bccfeee8f5747 /tmp/ledgerlens-source.tar.gz
RUN tar -xzf /tmp/ledgerlens-source.tar.gz --strip-components=1 -C /app \
    && rm /tmp/ledgerlens-source.tar.gz \
    && pip install --no-cache-dir -r requirements-agent.txt \
    && useradd --create-home --uid 1000 user \
    && mkdir -p /home/user/ledgerlens-data \
    && chmod -R a+rX /app \
    && chown -R user:user /home/user/ledgerlens-data

USER user
ENV LEDGERLENS_DATA_DIR=/home/user/ledgerlens-data
EXPOSE 7860
CMD ["sh", "-c", "python scripts/download_agent_model.py && uvicorn agent_workspace.api:app --host 0.0.0.0 --port 7860"]
